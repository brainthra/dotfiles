# starship.toml
#
# Configuration for the Starship prompt. This file selects a color palette,
# enables a rich set of modules, and includes some basic substitutions and
# formatting rules. Install a Nerd Font for the best icon rendering.

"$schema" = "https://starship.rs/config-schema.json"

add_newline = true
scan_timeout = 20
command_timeout = 800
follow_symlinks = true
palette = "pro"

format = """
$os\
$username\
$hostname\
$directory\
$git_branch\
$git_commit\
$git_state\
$git_status\
$fill\
$kubernetes\
$docker_context\
$aws\
$gcloud\
$azure\
$terraform\
$python\
$nodejs\
$rust\
$golang\
$java\
$dotnet\
$php\
$ruby\
$lua\
$deno\
$bun\
$package\
$line_break\
$jobs\
$status\
$shell\
$character"""

right_format = """$cmd_duration$memory_usage$time"""

continuation_prompt = "[∙](bright-black) "

[palettes.pro]
fg = "#cdd6f4"
muted = "#6c7086"
surface = "#313244"
blue = "#89b4fa"
cyan = "#94e2d5"
green = "#a6e3a1"
yellow = "#f9e2af"
orange = "#fab387"
red = "#f38ba8"
pink = "#f5c2e7"
mauve = "#cba6f7"
peach = "#fab387"

[fill]
symbol = " "

[os]
disabled = false
style = "bold blue"
format = "[$symbol]($style)"

[os.symbols]
Alpine = " "
Amazon = " "
Android = " "
Arch = " "
CentOS = " "
Debian = " "
Fedora = " "
FreeBSD = " "
Kali = " "
Linux = " "
Macos = " "
Manjaro = " "
Mint = " "
NixOS = " "
Raspbian = " "
Redhat = " "
RedHatEnterprise = " "
SUSE = " "
Ubuntu = " "
Unknown = " "
Windows = " "

[username]
show_always = false
style_user = "bold fg"
style_root = "bold red"
format = "[$user]($style)[@](muted)"

[hostname]
ssh_only = true
ssh_symbol = " "
trim_at = "."
style = "bold yellow"
format = "[$ssh_symbol$hostname]($style) "

[directory]
style = "bold blue"
read_only = " "
read_only_style = "red"
truncation_length = 4
truncate_to_repo = true
fish_style_pwd_dir_length = 1
format = "[$path]($style)[$read_only]($read_only_style) "

[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = " "
"Pictures" = " "
"Desktop" = " "
"Projects" = "󰲋 "

[git_branch]
symbol = " "
style = "bold mauve"
format = "[$symbol$branch(:$remote_branch)]($style) "

[git_commit]
only_detached = true
tag_disabled = false
tag_symbol = "  "
style = "bold yellow"
format = "[$hash$tag]($style) "

[git_state]
style = "bold orange"
format = '\([$state( $progress_current/$progress_total)]($style)\) '

[git_status]
style = "bold red"
format = '([$all_status$ahead_behind]($style) )'
conflicted = "=${count}"
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
up_to_date = ""
untracked = "?${count}"
stashed = "󰏗 ${count}"
modified = "!${count}"
staged = "+${count}"
renamed = "»${count}"
deleted = "✘${count}"

[kubernetes]
disabled = false
symbol = "󱃾 "
style = "bold cyan"
format = '[$symbol$context( \($namespace\))]($style) '

[[kubernetes.contexts]]
context_pattern = ".*prod.*"
style = "bold red"
symbol = "󱃾 PROD "

[[kubernetes.contexts]]
context_pattern = ".*staging.*"
style = "bold yellow"
symbol = "󱃾 STG "

[docker_context]
symbol = " "
style = "bold blue"
format = "[$symbol$context]($style) "
only_with_files = true

[aws]
symbol = " "
style = "bold orange"
format = '[$symbol($profile)(\($region\))]($style) '
force_display = false

[gcloud]
symbol = "󱇶 "
style = "bold blue"
format = '[$symbol$account(@$domain)(\($region\))]($style) '

[azure]
disabled = false
symbol = "󰠅 "
style = "bold blue"
format = "[$symbol$subscription]($style) "

[terraform]
symbol = "󱁢 "
style = "bold mauve"
format = "[$symbol$workspace]($style) "

[python]
symbol = " "
style = "bold yellow"
format = '[$symbol$pyenv_prefix($version)(\($virtualenv\))]($style) '

[nodejs]
symbol = " "
style = "bold green"
format = "[$symbol($version)]($style) "

[rust]
symbol = " "
style = "bold orange"
format = "[$symbol($version)]($style) "

[golang]
symbol = " "
style = "bold cyan"
format = "[$symbol($version)]($style) "

[java]
symbol = " "
style = "bold red"
format = "[$symbol($version)]($style) "

[dotnet]
symbol = "󰪮 "
style = "bold mauve"
format = "[$symbol($version)(  $tfm)]($style) "

[php]
symbol = " "
style = "bold mauve"
format = "[$symbol($version)]($style) "

[ruby]
symbol = " "
style = "bold red"
format = "[$symbol($version)]($style) "

[lua]
symbol = " "
style = "bold blue"
format = "[$symbol($version)]($style) "

[deno]
symbol = " "
style = "bold green"
format = "[$symbol($version)]($style) "

[bun]
symbol = " "
style = "bold yellow"
format = "[$symbol($version)]($style) "

[package]
symbol = "󰏗 "
style = "bold peach"
format = "[$symbol$version]($style) "

[jobs]
symbol = " "
style = "bold blue"
number_threshold = 1
symbol_threshold = 1
format = "[$symbol$number]($style) "

[status]
disabled = false
symbol = "✘"
success_symbol = ""
not_executable_symbol = "󰂭"
not_found_symbol = "󰍉"
sigint_symbol = "󰂭"
signal_symbol = "󱐋"
style = "bold red"
format = "[$symbol$status]($style) "

[shell]
disabled = false
bash_indicator = "bash"
zsh_indicator = "zsh"
fish_indicator = "fish"
powershell_indicator = "pwsh"
nu_indicator = "nu"
cmd_indicator = "cmd"
unknown_indicator = "shell"
style = "muted"
format = "[$indicator]($style) "

[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"
vimcmd_symbol = "[❮](bold green)"
vimcmd_replace_one_symbol = "[❮](bold mauve)"
vimcmd_replace_symbol = "[❮](bold mauve)"
vimcmd_visual_symbol = "[❮](bold yellow)"

[cmd_duration]
min_time = 1500
show_milliseconds = false
show_notifications = false
min_time_to_notify = 45000
style = "bold yellow"
format = "[󱎫 $duration]($style) "

[memory_usage]
disabled = true
threshold = 75
symbol = "󰍛 "
style = "bold red"
format = "[$symbol${ram_pct}]($style) "

[time]
disabled = false
time_format = "%H:%M"
style = "muted"
format = "[$time]($style)"
