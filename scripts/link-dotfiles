#!/usr/bin/env bash

set -Eeuo pipefail

repo_root="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1
  pwd
)"

cd "$repo_root/stow"

packages=(
  shell
  git
  starship
  direnv
  lazygit
  tig
  mise
)

backup_dir="$HOME/.pre-dot"
mkdir -p "$backup_dir"

for package in "${packages[@]}"; do
  package_dir="$repo_root/stow/$package"

  while IFS= read -r -d '' source; do
    relative="${source#"$package_dir/"}"
    target="$HOME/$relative"

    if [[ -e "$target" && ! -L "$target" ]]; then
      backup="$backup_dir/$relative"

      echo "Moving existing $target -> $backup"

      mkdir -p "$(dirname "$backup")"
      mv "$target" "$backup"
    fi
  done < <(find "$package_dir" -type f -print0)

  stow \
    --dir="$repo_root/stow" \
    --target="$HOME" \
    --restow \
    "$package"
done